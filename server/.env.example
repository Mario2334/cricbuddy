# cricbuddy-api — copy to .env (server: /root/apps/cricbuddy-api/.env; local dev: server/.env.local)

# Grist (the new "DevSena" document; create it once with: GRIST_URL=https://veyden.tail2874a5.ts.net:8484 npm run setup:grist)
GRIST_DOC_ID=
# On the server Grist is on the Docker bridge; from the Mac use https://veyden.tail2874a5.ts.net:8484
GRIST_URL=http://127.0.0.1:8484
GRIST_USER=sanketm221995@gmail.com
# GRIST_API_KEY=            # not needed while Grist trusts the Tailscale-User-Login header

# Who may call the API (tailnet logins, comma separated). "*" disables the check: local development only.
ALLOWED_USERS=sanketm221995@gmail.com

# Team
TEAM_ID=5179117
TEAM_NAME=Dev-Sena

# Codex CLI (logged in on the server as root)
# CODEX_BIN=/root/.local/bin/codex
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_S=600
# CODEX_FAKE=src/__tests__/fixtures/report.json   # return a canned plan instead of calling Codex (UI work)

# Limits and windows
ANALYSIS_DAILY_CAP=10
ROSTER_WINDOW=20
OUR_WINDOW=10
OPP_WINDOW=5
GROUND_WINDOW=5

# Where cached scorecards and per-job work dirs live (relative to the app folder)
CACHE_DIR=./cache
WORK_DIR=./work

# CricHeroes web-client credentials (defaults are the ones the app ships with; override if they rotate)
# CH_API_KEY=
# CH_AUTHORIZATION=
# CH_UDID=

PORT=8787
HOST=127.0.0.1
