{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "jest",
      "react-native"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "phosphor-react-native/src/icons/*": [
        "node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/**/*",
    "App.tsx"
  ],
  "exclude": [
    "node_modules",
    "server"
  ]
}
